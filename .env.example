# =====================================================================
# Torrent Media Manager (v1.1.1) Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# qBittorrent Web UI Settings
# ---------------------------------------------------------------------
# URL to access qBittorrent Web API
QBITTORRENT_HOST=http://127.0.0.1:8080

# Web UI authentication credentials
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# ---------------------------------------------------------------------
# TMDb (The Movie Database) API Configuration
# ---------------------------------------------------------------------
# API key (v3 auth) for looking up movies and TV show metadata
TMDB_API_KEY=your_tmdb_api_key_here

# ---------------------------------------------------------------------
# Download & Storage Paths
# ---------------------------------------------------------------------
# Directory where qBittorrent stores actively downloading files
QBIT_INCOMPLETE_PATH=/mnt/dlc_data/torrents/InComplete

# Directory where qBittorrent places finished downloads
QBIT_COMPLETE_PATH=/mnt/dlc_data/torrents/Complete

# Watch folder scanned by Torrent Media Manager for incoming releases (usually same as QBIT_COMPLETE_PATH)
WATCH_PATH=/mnt/dlc_data/torrents/Complete

# Mount point or directory checked for available storage space before initiating downloads
DOWNLOAD_DISK_PATH=/mnt/dlc_data/torrents

# Minimum free disk space in Gigabytes required on DOWNLOAD_DISK_PATH
MIN_FREE_DLC_SPACE_GB=20

# Whether to ensure qBittorrent preallocates full disk space for selected files (true/false)
QBIT_PREALLOCATE_DISK_SPACE=true

# Staging path on the media volume for processing and MKV muxing before final import
STAGING_PATH=/mnt/main_data/Media/InComplete

# ---------------------------------------------------------------------
# Media Library Destination Directories
# ---------------------------------------------------------------------
# Movies library directory
MOVIES_PATH=/mnt/main_data/Media/Video/Films

# TV Series library directory
TV_PATH=/mnt/main_data/Media/Video/Serials

# Anime library directory
ANIME_PATH=/mnt/main_data/Media/Video/Anime

# Cartoons library directory
CARTOONS_PATH=/mnt/main_data/Media/Video/Mults

# ---------------------------------------------------------------------
# Import & Cleanup Behavior
# ---------------------------------------------------------------------
# Import method: 'copy', 'move', or 'hardlink'
IMPORT_MODE=copy

# Whether to delete the source files in WATCH_PATH after successful import into library
DELETE_SOURCE_AFTER_IMPORT=false

# ---------------------------------------------------------------------
# Application & Database Settings
# ---------------------------------------------------------------------
# Absolute path to the SQLite application database inside container or host
DB_PATH=/app/data/app.db

# Background watcher interval in seconds for polling downloads and auto-import
AUTO_IMPORT_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------
# Permissions & User Ownership (UID / GID)
# ---------------------------------------------------------------------
# Primary user/group for media library files (smbwriter: 1000:1000)
PUID=1000
PGID=1000
TARGET_UID=1000
TARGET_GID=1000

# User/group for qBittorrent downloads (qbittorrent-nox: 1002:1003)
QBIT_UID=1002
QBIT_GID=1003

# Supplementary Group ID to grant container access to qbittorrent files
SUPPLEMENTARY_GIDS=1003

# Default directory permissions in octal format
DIR_MODE=775

# Default file permissions in octal format
FILE_MODE=775

# File creation umask
UMASK=002
